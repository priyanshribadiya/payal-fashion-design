# ==============================================================================
# PAYAL FASHION DESIGN - BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/payal_fashion_design?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/payal_fashion_design

# JSON Web Token Secret Keys
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_secure_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Credentials (used only by npm run create-admin)
INITIAL_ADMIN_EMAIL=admin@payalfashiondesign.com
INITIAL_ADMIN_PHONE=+919723814909
INITIAL_ADMIN_NAME=Payal Fashion Admin
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Store Boutique WhatsApp Number (Country code + 10 digits without + or spaces)
STORE_WHATSAPP_NUMBER=919723814909
STORE_BRAND_NAME=Payal Fashion Design

# Razorpay Test / Production Credentials
# Leave as test placeholders in development (safe test mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit_real
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# OTP & Communications Provider (Development Sandbox Mode)
# In development, OTPs are safely logged to the server console and test API
OTP_SANDBOX_MODE=true
OTP_EXPIRY_MINUTES=10

# Optional: Real Email Provider (Nodemailer / Resend / SendGrid / AWS SES)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=Payal Fashion Design <no-reply@payalfashiondesign.com>

# Optional: Real Indian SMS Provider (Fast2SMS / Msg91 / Twilio)
SMS_SERVICE_ENABLED=false
SMS_PROVIDER=msg91
SMS_API_KEY=your_sms_provider_api_key
